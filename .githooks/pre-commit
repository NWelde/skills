#!/bin/bash

echo "Running tests..."

cd "$(git rev-parse --show-toplevel)"

# Run the SAME full suite as CI (pytest -v over every testpath in
# pyproject.toml), not just the root tests/. Uses pipx/uvx when available so it
# works on systems with an externally managed Python.
if command -v pipx &> /dev/null; then
    pipx run pytest -v
elif command -v uvx &> /dev/null; then
    uvx pytest -v
else
    python3 -m pytest -v
fi

if [ $? -ne 0 ]; then
    echo ""
    echo "Tests failed. Commit aborted."
    exit 1
fi

echo "All tests passed."
